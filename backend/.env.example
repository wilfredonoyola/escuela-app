# Copia este archivo a .env (cp .env.example .env) y ajusta los valores.
PORT=4000
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32+chars
JWT_EXPIRES_IN_SECONDS=3600
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGIN=http://localhost:3000
# TTL de la caché de lecturas en milisegundos
CACHE_TTL_MS=60000
DATA_DIR=./data
